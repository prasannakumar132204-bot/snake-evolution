<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180">
  <defs>
    <linearGradient id="snakeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00ff88;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#00d4ff;stop-opacity:1" />
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="180" height="180" rx="36" fill="#0a0f1a"/>
  <rect width="180" height="180" rx="36" fill="none" stroke="url(#snakeGradient)" stroke-width="4"/>
  
  <!-- Snake body -->
  <path d="M40 90 Q65 40 90 90 Q115 140 140 90" 
        stroke="url(#snakeGradient)" 
        stroke-width="16" 
        fill="none" 
        stroke-linecap="round"
        filter="url(#glow)"/>
  
  <!-- Snake head -->
  <circle cx="140" cy="90" r="20" fill="url(#snakeGradient)" filter="url(#glow)"/>
  
  <!-- Eyes -->
  <circle cx="145" cy="82" r="4" fill="#0a0f1a"/>
  <circle cx="145" cy="98" r="4" fill="#0a0f1a"/>
</svg>